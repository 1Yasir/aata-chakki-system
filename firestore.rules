rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /daily_entries/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read, write: if request.auth != null;
    }

    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /customer_transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }

    match /own_wheat_purchases/{entryId} {
      allow read, write: if request.auth != null;
    }

    match /employees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    match /employee_transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }

    // GENERAL UDHAAR KHATA RULES
    match /general_udhaar_customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /general_udhaar_transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
  }
}